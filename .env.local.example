# Harid AI Recruiting — environment variables
# Copy to .env.local and fill in. All are OPTIONAL: without them the
# interview falls back to a built-in deterministic demo script.

# Google Gemini (preferred when set)
GOOGLE_API_KEY=

# OpenAI fallback
OPENAI_API_KEY=

# HR dashboard login (server-side only — do NOT expose to the client)
HR_EMAIL=dev@mail.it
HR_PASSWORD=change-me-in-production
